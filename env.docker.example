# Copy values into a shell env or a local .env next to docker-compose.yml
WEB_PORT=3000
API_PORT=8000
APP_ENV=development
APP_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_SECONDS=7200
JWT_REFRESH_EXPIRES_SECONDS=7200
POSTGRES_PASSWORD=mess
REDIS_PASSWORD=
SEED_STAFF_PASSWORD=ChangeMe!
REDIS_CACHE_TTL=120
# Production: https://ms.apptriangle.com
# Local: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=https://ms.apptriangle.com
# Production HTTPS: leave empty so the browser calls /api on the same host.
# Local bun only: http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_URL=http://api:8000
NEXT_PUBLIC_USE_API=true
NEXT_PUBLIC_ZK_DEMO=false
