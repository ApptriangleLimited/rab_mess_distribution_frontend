DOMAIN=ms.apptriangle.com
HOST_PORT=3000
CONTAINER_PORT=8080

# FastAPI origin. Used only when NEXT_PUBLIC_USE_API=true.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# API_PROXY_URL=http://127.0.0.1:8000

NEXT_PUBLIC_API_BASE_URL=http://api.ms.apptriangle.com
API_PROXY_URL=http://api.ms.apptriangle.com

# true = JWT / FastAPI. false = localStorage demo, no API calls (server deploy without backend).
NEXT_PUBLIC_USE_API=false

# Live ZK punches in Meal Reports (Consume / Duplicate). Needs API on :8000.
# Also turns on Next rewrite /api/v1 → backend (even if USE_API=false).
NEXT_PUBLIC_ZK_DEMO=true
