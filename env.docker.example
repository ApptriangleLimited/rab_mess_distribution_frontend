# Copy to .env on the server. CI/CD keeps that file; do not commit it.
# Postgres/Redis passwords must stay stable once volumes exist.

DOMAIN=ms.apptriangle.com
WEB_PORT=3000
API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

APP_ENV=production
APP_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_SECONDS=7200
JWT_REFRESH_EXPIRES_SECONDS=7200
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
SEED_STAFF=true
SEED_STAFF_PASSWORD=ChangeMe!
REDIS_CACHE_TTL=120
CORS_ORIGINS=https://ms.apptriangle.com,https://www.ms.apptriangle.com
PUBLIC_APP_URL=https://ms.apptriangle.com

# Browser must stay same-origin. Do not set these to https://api.ms.apptriangle.com
# or PNG upload and login hit CORS. Compose already proxies /api to the api service.
NEXT_PUBLIC_USE_API=true
NEXT_PUBLIC_ZK_DEMO=false
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_URL=http://api:8000
